---
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
}
const { book } = Astro.props;
---

<div class="book-card">
  <p class="book-title">{book.data.title}, ⭐{book.data.rating}/5</p>
  <p class="book-author">by {book.data.author}</p>
  <p class="book-summary">{book.data.summary}</p>
  <a href="">Read review</a>
</div>

<style>
  h2 {
    padding-right: 10px;
    border-right: 8px solid #ebe5f2;
    border-bottom: 8px solid #f9f6fc;
    margin-bottom: 40px;
    text-align: right;
  }
  .book-card {
    background-color: #f9f6fc;
    padding: 16px 20px;
    margin: 20px auto;
    box-shadow: 8px 8px 0 #ebe5f2;
  }
  .book-title {
    font-size: 1.4em;
    font-weight: bold;
    margin: 0;
  }
  .book-author {
    margin-top: 0;
  }
  .book-summary {
    font-size: 1em;
  }
</style>
